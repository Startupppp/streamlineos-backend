{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/scripts/**/*.{ts,mjs}",
    "src/db/seeds/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.e2e-spec.ts",
    "src/test/**/*.ts",
    "test/**/*.ts",
    "evals/**/*.spec.ts",
    "scripts/**/*.mjs",
    "evals/**/*.ts",
    "drizzle.config.ts",
    "eslint.config.mjs"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "evals/**/*.ts"],
  "ignore": [
    "migrations/**",
    "dist/**",
    "src/@types/**",
    "src/common/validation/validate.decorator.ts",
    "src/modules/rbac/permissions/**",
    "src/db/schema/hrms-phase1-sql-managed.ts",
    "src/db/schema/directory/worker-engagement-state-events.ts",
    "src/db/schema/hr/audit-events.ts",
    "src/db/schema/hr/worker-leave-ledger.ts"
  ],
  "ignoreDependencies": ["multer", "@types/multer"],
  "ignoreExportsUsedInFile": true
}
