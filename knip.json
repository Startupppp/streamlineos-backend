{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/scripts/**/*.{ts,mjs}",
    "src/db/seeds/**/*.ts",
    "src/**/*.spec.ts",
    "src/**/*.e2e-spec.ts",
    "src/test/**/*.ts",
    "test/**/*.ts",
    "evals/**/*.spec.ts",
    "scripts/**/*.mjs",
    "evals/**/*.ts",
    "src/db/schema/hrms-phase1-sql-managed.ts"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "evals/**/*.ts"],
  "paths": {
    "test/*": ["./test/*"],
    "src/*": ["./src/*"]
  },
  "ignore": [
    "src/modules/rbac/permissions/**"
  ],
  "ignoreDependencies": ["multer", "@types/multer"],
  "ignoreExportsUsedInFile": true
}
