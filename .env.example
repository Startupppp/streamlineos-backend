# ═══════════════════════════════════════════════════════════════
# STREAMLINEOS — Backend Environment Variables
# Copy to .env and fill in your values.
# Start locally with: node --env-file=.env dist/main.js
# ═══════════════════════════════════════════════════════════════

# ─── Core (required) ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=1500
DATABASE_URL=postgres://user:pass@host.neon.tech/db?sslmode=require
# Comma-separated browser origins allowed to call this API (CORS). Not the API hostname.
# Local: http://localhost:1000
# Production: https://www.streamlineos.in,https://streamlineos.in
CORS_ORIGINS=http://localhost:1000
# Must be >=44 chars (256-bit) and IDENTICAL to BACKEND_JWT_SECRET in the frontend .env.
BACKEND_JWT_SECRET=generate-with-openssl-rand-base64-48
# Must be >=32 chars and IDENTICAL to INTERNAL_API_SECRET in the frontend .env.
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-48
# Public web app origin (auth redirects, email links). Production: https://www.streamlineos.in
APP_URL=http://localhost:1000
# Required in production (cron endpoint auth).
CRON_SECRET=generate-with-openssl-rand-base64-48
# Required to store payment-provider secrets (AES key, 64 hex chars).
ENCRYPTION_KEY=
# Optional: dedicated secret for AI action-confirmation tokens (falls back to BACKEND_JWT_SECRET).
# AI_CONFIRMATION_SECRET=

# ─── Outbound Email ────────────────────────────────────────────────────────
EMAIL_PROVIDER=zeptomail
# ZeptoMail (Zoho) API — token is the Mail Agent Send Mail API key ("Zoho-enczapikey ..." prefix optional).
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=
# Do not use onboarding@resend.dev — Resend sandbox only delivers to the account owner.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=support@streamlineos.in
EMAIL_FROM_NAME=StreamlineOS
# Optional: public site URL for email links when APP_URL is a local/LAN address.
# EMAIL_APP_URL=https://www.streamlineos.in
# Recipient for contact-form notifications (required in production).
CONTACT_NOTIFICATION_EMAIL=
# Organizer address on ICS calendar invites (interview scheduling).
NOREPLY_EMAIL=

# ─── SMS / WhatsApp (Twilio — unset disables the channel) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Cloudflare Turnstile (secret key — site key lives in frontend) ────────
TURNSTILE_SECRET_KEY=

# ─── Composio (managed integrations: calendar + mail) — app.composio.dev ───
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=

# ─── Razorpay (payments) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Embeddings / KB RAG ALWAYS use OPENAI_API_KEY (OpenRouter has no embeddings endpoint) — keep it set even when using OpenRouter.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# AI provider selection (unset = defaults: OpenAI for tasks, Gemini for chat).
# AI_LLM_PROVIDER: openai (default) | openrouter — CRM/HR/Projects text tasks.
AI_LLM_PROVIDER=
# AI_CHAT_PROVIDER: google (default) | openrouter — streaming "Ask AI" assistant.
AI_CHAT_PROVIDER=

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public CDN base URL for the R2 bucket (no trailing slash). Read by the BACKEND
# (email logo + public storage URLs) despite the NEXT_PUBLIC_ prefix.
# Email headers use the PNG at: <NEXT_PUBLIC_R2_PUBLIC_URL>/email-assets/logo-v2.png
# (upload a 120x120px PNG there; without this, emails show a styled "S" monogram).
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional dedicated KB media bucket (falls back to the main bucket).
R2_KB_BUCKET_NAME=
R2_KB_PUBLIC_URL=

# ─── Upstash Redis (cache + rate-limiting) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push Notifications (VAPID keypair) ────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Ably (realtime chat / presence) ───────────────────────────────────────
ABLY_API_KEY=

# ─── Optional tuning (defaults shown) ──────────────────────────────────────
# APP_BRAND_NAME=StreamlineOS
# CHAT_REPLY_REMINDER_MINUTES=15
# NOTIFICATIONS_INPROCESS_WORKER=true
# NOTIFICATIONS_WORKER_INTERVAL_MS=15000
