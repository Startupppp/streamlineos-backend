NODE_ENV=development
PORT=1500
CORS_ORIGINS=http://localhost:1000

# Copy from streamlineos-frontend/.env — must stay in sync during migration
DATABASE_URL=postgres://user:pass@host.neon.tech/db?sslmode=require
BACKEND_JWT_SECRET=replace-with-same-value-as-NEXTAUTH_SECRET-in-web-app
NEXTAUTH_URL=http://localhost:1000
NEXT_PUBLIC_APP_URL=http://localhost:1000
# Used in verification/reset email links (defaults to NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:1000

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ENCRYPTION_KEY=
CRON_SECRET=
WEBHOOK_SECRET=
NAUKRI_WEBHOOK_SECRET=
LINKEDIN_WEBHOOK_SECRET=
INDEED_WEBHOOK_SECRET=
ESIGN_WEBHOOK_SECRET=
BIOMETRIC_API_KEY=

RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=support@streamlineos.in
EMAIL_FROM_NAME=StreamlineOS
EMAIL_PROVIDER=resend
# Do not use onboarding@resend.dev — Resend sandbox only delivers to the account owner.
ADMIN_NOTIFICATION_EMAIL=
OWNER_EMAIL=

R2_ACCOUNT_ID=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_ENDPOINT=
R2_SECRET_ACCESS_KEY=
# Public CDN base URL for the R2 bucket (no trailing slash).
# When set, email headers use the PNG at: <NEXT_PUBLIC_R2_PUBLIC_URL>/email-assets/logo-v2.png
# Upload a 120x120px PNG logo to that path. Without this, emails show a styled "S" monogram.
NEXT_PUBLIC_R2_PUBLIC_URL=
R2_KB_BUCKET_NAME=
R2_KB_PUBLIC_URL=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

ABLY_API_KEY=

OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# AI provider selection (unset = defaults: OpenAI for tasks, Gemini for chat).
# Embeddings / KB RAG ALWAYS use OPENAI_API_KEY (OpenRouter has no embeddings endpoint) — keep it set even when using OpenRouter.
# AI_LLM_PROVIDER: openai (default) | openrouter — CRM/HR/Projects text tasks.
AI_LLM_PROVIDER=
# AI_CHAT_PROVIDER: google (default) | openrouter — streaming "Ask AI" assistant.
AI_CHAT_PROVIDER=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

DOCUMENSO_API_URL=
DOCUMENSO_API_TOKEN=

# Composio managed integrations (calendar accounts) - dashboard: app.composio.dev
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
