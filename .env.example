# Full contract. .env = local dev (only what you set); .env.production = prod mirror.
# Run: node --env-file=.env dist/main.js
NODE_ENV=development
# off | degrade; degrade is temporary non-production migration compatibility only.
RBAC_MIGRATION_MODE=off
PORT=1500
# Owner/admin role. Used by migrations and the db:* scripts, never by the running app under RLS.
DATABASE_URL=postgres://user:pass@host.neon.tech/db?sslmode=require

# The RLS-enforced application role: no ownership, no BYPASSRLS, DML only.
# Provision it with `pnpm db:bootstrap-role`, then point this at it.
# Leaving it unset falls back to DATABASE_URL, which bypasses every tenant policy —
# the app refuses to boot in production when that happens.
APP_DATABASE_URL=postgres://streamline_app:pass@host.neon.tech/db?sslmode=require

# Session-mode connection for migrations and db:verify-rls. Only Neon can be derived
# automatically from the pooled URL; every other provider must set this explicitly.
# DIRECT_DATABASE_URL=

# Connection pool. All optional; db/pool.config.ts resolves defaults per endpoint and
# logs the result at boot. Every authenticated request runs inside one tenant transaction,
# so DB_POOL_MAX is also the ceiling on concurrent authenticated requests.
# Defaults: 5 dev · 20 behind a -pooler endpoint or self-hosted · 10 on a direct Neon endpoint.
# DB_POOL_MAX=20
# Seconds. Idle low on Neon so the compute can scale down.
# DB_POOL_IDLE_TIMEOUT=15
# DB_POOL_CONNECT_TIMEOUT=30
# DB_POOL_MAX_LIFETIME=240
# DB_POOL_SHUTDOWN_TIMEOUT=5
# Guards in ms; 0 disables. Applied with SET LOCAL inside each tenant transaction, NOT as
# startup parameters — Neon's pooler silently drops those and rejects `options=-c ...` with
# 08P01. idle-in-transaction is the one that stops a handler stalled on an external call
# from pinning a connection: it fails with Postgres 25P03 instead of starving the pool.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=5000
# Borrows queued longer than this are counted in GET /health/db.
# DB_SLOW_ACQUIRE_MS=250
# Identifies this process in pg_stat_activity; give each deployment its own value.
# DB_APPLICATION_NAME=streamlineos-api

# Overrides for db:bootstrap-role (defaults: streamline_app, public).
# APP_DB_ROLE=streamline_app
# APP_DB_PASSWORD=
# APP_DB_SCHEMA=public
# Comma-separated browser origins (CORS). Prod: https://www.streamlineos.in,https://streamlineos.in
CORS_ORIGINS=http://localhost:1000
# >=44 chars, identical to frontend BACKEND_JWT_SECRET.
BACKEND_JWT_SECRET=
PORTAL_JWT_SECRET="generate-with-openssl-rand-base64-48-MUST-differ-from-BACKEND_JWT_SECRET"
# >=32 chars, identical to frontend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# Public web app origin (auth redirects, email links). Prod: https://www.streamlineos.in
APP_URL=http://localhost:1000
# Required in production (cron endpoint auth).
CRON_SECRET=
# REQUIRED (min 32 chars; 64 hex recommended). Encrypts payment-provider secrets and
# employee PII at rest. The app refuses to start without it — absence must never
# silently degrade to plaintext storage.
ENCRYPTION_KEY=
# Optional; falls back to BACKEND_JWT_SECRET.
# AI_CONFIRMATION_SECRET=
# zeptomail | resend
EMAIL_PROVIDER=zeptomail
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# Mail Agent Send Mail API key ("Zoho-enczapikey ..." prefix optional).
ZEPTOMAIL_TOKEN=
RESEND_API_KEY=
# Bounce/complaint webhooks (POST /webhooks/email/:provider). Unset = the endpoint
# rejects every callback, so bounces are never suppressed — set these in any
# environment that actually sends mail.
# Resend signs with Svix: the whsec_ value from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
# ZeptoMail: shared secret sent as x-zeptomail-webhook-secret. Stopgap until the
# provider's documented signature scheme is confirmed against a live account.
ZEPTOMAIL_WEBHOOK_SECRET=
# COMP-002. Signs one-click unsubscribe links (>=32 chars). Deliberately NOT the
# session JWT secret: these tokens travel in plain-text email and live in archives
# forever, so a leak must not be replayable against anything else. Unset disables
# unsubscribe links entirely.
UNSUBSCRIBE_TOKEN_SECRET=
EMAIL_FROM_ADDRESS=noreply@streamlineos.in
EMAIL_FROM_NAME=StreamlineOS
# Public site URL for email links when APP_URL is a local/LAN address.
# EMAIL_APP_URL=https://www.streamlineos.in
# Contact-form notification recipient; required in production.
CONTACT_NOTIFICATION_EMAIL=
# Organizer address on ICS interview invites.
NOREPLY_EMAIL=noreply@streamlineos.in
# SMS/WhatsApp channel; unset disables it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Pairs with frontend NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Managed integrations (calendar + mail) — app.composio.dev
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Embeddings/KB RAG always use OPENAI_API_KEY — keep it set even on openrouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# openai (default) | openrouter
AI_LLM_PROVIDER=
# Model fallback chains, comma-separated, tried in order after the tier's primary model
# when it rate-limits (429), is overloaded (503), or keeps failing transiently. Unset falls
# back to the other tier's configured model, so the chain only holds models you already have.
# Auth and malformed-request failures never retry or fall through — they fail identically.
# AI_FAST_FALLBACK_MODELS=gpt-4o,gpt-3.5-turbo
# AI_STANDARD_FALLBACK_MODELS=gpt-4o-mini
# Retries per model before moving to the next one (default 2, max 5). Backoff is exponential
# with jitter and honours the provider's Retry-After header.
# AI_LLM_MAX_RETRIES=2
# google (default) | openrouter
AI_CHAT_PROVIDER=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Public CDN base URL, no trailing slash; read by the BACKEND despite the prefix.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional dedicated KB media bucket; falls back to the main bucket.
R2_KB_BUCKET_NAME=
R2_KB_PUBLIC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ABLY_API_KEY=
# Optional tuning (defaults shown).
# APP_BRAND_NAME=StreamlineOS
# CHAT_REPLY_REMINDER_MINUTES=15
# NOTIFICATIONS_INPROCESS_WORKER=true
# NOTIFICATIONS_WORKER_INTERVAL_MS=15000
