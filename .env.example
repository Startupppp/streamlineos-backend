# what are all the tasks i have given and give me the report about they status and how much it  is done in a short and point wise

# --- Data residency -----------------------------------------------------------
# The region new organisations are placed in. The primary region inherits the
# flat DATABASE_URL / R2_* variables above, so a single-region deployment needs
# nothing here. Existing organisations were backfilled to "primary"; if you set
# this to something else, update organizations.region to match or placement will
# fail closed for them.
PRIMARY_REGION=primary

# Every region this deployment serves, comma separated. Each region other than
# the primary must be configured explicitly — a secondary never inherits the flat
# variables, so a typo cannot point two regions at one database.
#   REGION_KEYS=eu,us,in
#   REGION_US_APP_DATABASE_URL=postgres://...
#   REGION_US_R2_BUCKET_NAME=...
#   REGION_US_R2_ENDPOINT=...
# REGION_KEYS=

# The cell this deployment is. A cell is the unit of capacity, deployment and
# blast radius; a region is where it sits. The existing production deployment is
# cell "legacy-1", which is what migration 0608 backfills onto every
# organization_placement row, so leaving these unset keeps today's behaviour.
# A secondary region names its own with REGION_<KEY>_CELL_ID and never inherits
# these, for the same reason it never inherits the flat database variables.
CELL_ID=legacy-1
DATABASE_SHARD=primary
SEARCH_CLUSTER=primary

# Signs the placement a session carries, so a cell can verify for itself where an
# organisation lives instead of trusting the cache it arrived in. Falls back to
# BACKEND_JWT_SECRET, so an existing deployment needs nothing here.
#
# This is a CONTROL-PLANE-GLOBAL key, not a per-cell one: a relocating
# organisation's placement is issued by the control plane rather than by either
# cell, so a per-cell key would leave a MOVING organisation unverifiable in its
# target. The key id travels in the token, so rotation is a second key rather
# than a flag day — set PREVIOUS to the outgoing key while sessions drain.
# PLACEMENT_SIGNING_KEY=
# PLACEMENT_SIGNING_KEY_ID=cp-1
# PLACEMENT_SIGNING_KEY_PREVIOUS=
# PLACEMENT_SIGNING_KEY_PREVIOUS_ID=cp-0

# --- Cell-2 resource configuration -------------------------------------------
# cell-2 shares the same Neon project and compute as legacy-1 (CELL_ID=legacy-1).
# Its own database (cell2) is provisioned and verified via `pnpm cell:bootstrap`.
# The variables below upgrade shared resources from SHARED to NAMESPACED or
# ISOLATED. `cell:isolation` reports the current verdict for each resource.
#
# Database (already ISOLATED — separate logical DB in the same Neon project):
REGION_KEYS=primary,cell-2
REGION_CELL_2_DATABASE_URL=postgres://user:pass@host.neon.tech/cell2?sslmode=require
REGION_CELL_2_APP_DATABASE_URL=postgres://streamline_app:pass@host.neon.tech/cell2?sslmode=require
REGION_CELL_2_CELL_ID=cell-2
REGION_CELL_2_DATABASE_SHARD=cell-2
REGION_CELL_2_SEARCH_CLUSTER=cell-2
#
# Cache (Redis) — NAMESPACED: set the key prefix so every key for an org in
# cell-2 carries the "cell-2/" prefix, preventing accidental cross-cell
# collisions in the shared Upstash instance.
# Limitation: namespace isolation does not protect against a holder of the
# master UPSTASH_REDIS_REST_TOKEN reading all cells' cached data.
# To reach ISOLATED, provision a second Upstash instance and set:
#   REGION_CELL_2_UPSTASH_REDIS_REST_URL=https://<cell-2-instance>.upstash.io
#   REGION_CELL_2_UPSTASH_REDIS_REST_TOKEN=<cell-2-token>
REGION_CELL_2_CACHE_KEY_PREFIX=cell-2
#
# Object storage — NAMESPACED: set a key prefix so every object for an org in
# cell-2 lives under "cell-2/" within the shared R2 bucket.
# Limitation: prefix separation does not protect against a holder of the R2
# access key reading all cells' objects.
# To reach ISOLATED, provision a dedicated R2 bucket and set:
#   REGION_CELL_2_R2_BUCKET_NAME=<cell-2-bucket>
#   REGION_CELL_2_R2_ENDPOINT=https://<cell-2-endpoint>.r2.cloudflarestorage.com
#   REGION_CELL_2_R2_ACCESS_KEY_ID=<cell-2-key-id>
#   REGION_CELL_2_R2_SECRET_ACCESS_KEY=<cell-2-secret>
REGION_CELL_2_R2_KEY_PREFIX=cell-2
#
# Worker pools — NAMESPACED when CELL_ID is set on the worker process.
# Cron lease keys are `cron:lease:cell-2:<job>` so two cells cannot take each
# other's slots. forEachOrg also uses the cell's own database for enumeration.
# No additional variable needed here; the REGION_CELL_2_CELL_ID above wires it.
#
# Realtime (Ably) — NAMESPACED at the channel level (cell:cell-2:*).
# A holder of the master ABLY_API_KEY can still publish to any cell's namespace.
# To reach ISOLATED, provision a second Ably application and set:
#   REGION_CELL_2_ABLY_API_KEY=<cell-2-ably-root-key>
#
# Monitoring — NAMESPACED when CELL_ID=cell-2 is set on the process.
# Every log line carries cellId="cell-2". No additional variable needed.
#
# Search — SHARED (no search cluster is deployed for any cell).
# To provision: set REGION_CELL_2_SEARCH_CLUSTER and REGION_CELL_2_SEARCH_API_KEY
# to a cell-2-owned index.
