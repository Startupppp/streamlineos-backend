# Full contract. .env = local dev (only what you set); .env.production = prod mirror.
# Run: node --env-file=.env dist/main.js
NODE_ENV=development
TZ=UTC
PORT=1500
# Stamped onto every reported error so a spike can be pinned to a deploy. Set it
# in CI to the commit sha. Optional and unvalidated on purpose: an unset release
# costs one log field, and refusing to boot without it would be a worse trade.
APP_RELEASE=
# AWS Aurora PostgreSQL / RDS. Password authentication by default; see DB_IAM_AUTH below.
# Use the WRITER/cluster endpoint, not an instance endpoint or cluster-ro reader endpoint.
# URL-encode passwords before embedding them (for example @ becomes %40).
# Owner/admin role. Used by migrations and db:* scripts, never by runtime traffic.
DATABASE_URL=postgresql://postgres:<url-encoded-master-password>@streamlineos.cluster-replace-me.ap-south-1.rds.amazonaws.com:5432/streamlineos?sslmode=require

# The RLS-enforced application role: no ownership, no BYPASSRLS, DML only.
# Provision it with `pnpm db:bootstrap-role`, then point this at it.
# Leaving it unset falls back to DATABASE_URL, which bypasses every tenant policy —
# the app refuses to boot in production when that happens.
APP_DATABASE_URL=postgresql://streamline_app:<url-encoded-app-password>@streamlineos.cluster-replace-me.ap-south-1.rds.amazonaws.com:5432/streamlineos?sslmode=require

# Mint a short-lived IAM token per connection instead of reading a password from
# the URL above. With this set, a passwordless RDS URL is accepted; without it,
# one is refused, because a URL with no password and no IAM is a connection that
# cannot authenticate at all. The instance needs rds-db:connect for the role.
DB_IAM_AUTH=

# Aurora/RDS has no separate transaction-pooler endpoint, so this intentionally equals
# DATABASE_URL. It remains separate because migration scripts require owner credentials.
DIRECT_DATABASE_URL=postgresql://postgres:<url-encoded-master-password>@streamlineos.cluster-replace-me.ap-south-1.rds.amazonaws.com:5432/streamlineos?sslmode=require

# Setup-only values used by `pnpm db:setup` / `pnpm db:bootstrap-role`.
# APP_DB_PASSWORD is unencoded; APP_DATABASE_URL contains its URL-encoded form.
# Remove APP_DB_PASSWORD from the deployed runtime environment after provisioning.
APP_DB_ROLE=streamline_app
APP_DB_PASSWORD=replace-with-at-least-16-random-characters
APP_DB_SCHEMA=public,build,build_events,app

# Read replica for reporting-shaped queries. Optional; unset means every read goes
# to the primary.
# DB_REPLICA_URL=

# Connection pool. All optional; db/pool.config.ts resolves defaults per endpoint and
# logs the result at boot. Every authenticated request runs inside one tenant transaction,
# so DB_POOL_MAX is also the ceiling on concurrent authenticated requests.
# Defaults: 5 dev · 20 behind a Neon pooler/self-hosted · 10 on direct Neon or AWS.
# Aurora Serverless: release idle clients for auto-pause and allow 30s for resume.
# Total possible connections = DB_POOL_MAX multiplied by backend replica count.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=15
DB_POOL_CONNECT_TIMEOUT=30
DB_POOL_MAX_LIFETIME=900
# DB_POOL_SHUTDOWN_TIMEOUT=5
# Guards in ms; 0 disables. Applied with SET LOCAL inside each tenant transaction, NOT as
# startup parameters — Neon's pooler silently drops those and rejects `options=-c ...` with
# 08P01. idle-in-transaction is the one that stops a handler stalled on an external call
# from pinning a connection: it fails with Postgres 25P03 instead of starving the pool.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=5000
# Borrows queued longer than this are counted in GET /health/db.
# DB_SLOW_ACQUIRE_MS=250
# Pool admission control. Enabled by default; it sheds a borrow rather than letting the
# queue grow without bound, so a slow database degrades into fast 503s instead of a stall.
# DB_POOL_ADMISSION_ENABLED=true
# Max borrows allowed to queue for a connection. Defaults to DB_POOL_MAX * 4.
DB_POOL_QUEUE_DEPTH=40
# Milliseconds a borrow may wait before it is shed.
DB_POOL_ACQUIRE_TIMEOUT_MS=5000
# Identifies this process in pg_stat_activity; give each deployment its own value.
DB_APPLICATION_NAME=streamlineos-api
# Optional Aurora reader endpoint; leave blank until the cluster has a reader instance.
# It uses the restricted application role, never the master role.
# DB_REPLICA_URL=postgresql://streamline_app:<url-encoded-app-password>@streamlineos.cluster-ro-replace-me.ap-south-1.rds.amazonaws.com:5432/streamlineos?sslmode=require

# Comma-separated browser origins (CORS). Prod: https://www.streamlineos.in,https://streamlineos.in
CORS_ORIGINS=http://localhost:1000
# >=44 chars. Used for placement signing and IP-pseudonymisation fallbacks.
# No longer used for JWT signing — see AUTH_SIGNING_KEYS below.
BACKEND_JWT_SECRET=
# Ed25519 keypair(s) for asymmetric JWT signing. JSON array of {kid, privateKey (JWK), publicKey (JWK)}.
# Generate with: node -e "const {generateKeyPairSync}=require('crypto');const kp=generateKeyPairSync('ed25519');const p=kp.privateKey.export({type:'pkcs8',format:'jwk'});const u=kp.publicKey.export({type:'spki',format:'jwk'});const kid='key-'+Date.now();console.log(JSON.stringify([{kid,privateKey:p,publicKey:u}]))"
# At least one entry is required for the auth module to start.
AUTH_SIGNING_KEYS=
PORTAL_JWT_SECRET="generate-with-openssl-rand-base64-48-MUST-differ-from-BACKEND_JWT_SECRET"
# >=32 chars, identical to frontend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# Must match frontend NEXTAUTH_SECRET exactly — used to verify session-exchange proofs.
# Copy the value from frontend/.env.
NEXTAUTH_SECRET=
# Public web app origin (auth redirects, email links). Prod: https://www.streamlineos.in
APP_URL=http://localhost:1000
# Required in production (cron endpoint auth).
CRON_SECRET=
# Comma-separated recipients notified when someone joins the public waitlist.
WAITLIST_NOTIFICATION_EMAILS=
# Set to "false" only in a deliberate deployment config: it disables RouteClassifierGuard,
# so a handler that declares no exposure stops being denied at boot and at request time.
REQUIRE_ROUTE_CLASSIFICATION=
# Which e-invoice transport is wired up: "none" (default), "mock" or "irp".
# "none" is the right value for any deployment without a GSP account — a reportable
# document is recorded as pending and nobody sends it, which is what the product does
# with none of this configured.
# "mock" exercises the whole submit path against an adapter that files nothing: it
# stamps rows with transport "mock_irp" and returns MOCK-prefixed acknowledgements, so a
# mock filing can never be mistaken for a real one in a database or a screenshot.
# Setting it on a production node makes the app REFUSE TO BOOT — running it there would
# record fabricated evidence of a statutory filing.
# "irp" FILES DOCUMENTS FOR REAL with the Indian Invoice Registration Portal through the
# GSP named below. The app REFUSES TO BOOT unless all five COMPLIANCE_IRP_* values are
# set: a partial set files nothing while the deployment believes it is filing.
COMPLIANCE_TRANSPORT=
# The live IRP/GSP connection, used only when COMPLIANCE_TRANSPORT=irp. All five are
# needed together; with any of them unset the adapter is inert, the registry will not
# select it, and the submit route answers an honest 409 saying nothing was sent.
# COMPLIANCE_IRP_URL is the FULL endpoint the GSP documents for registering a document —
# no path is appended to it. It must be https (loopback excepted, for the adapter's own
# tests): these credentials would otherwise cross the network in clear text.
COMPLIANCE_IRP_URL=
# Issued by the GSP, not by the GST portal.
COMPLIANCE_IRP_CLIENT_ID=
COMPLIANCE_IRP_CLIENT_SECRET=
# The taxpayer's own e-invoice API credentials, created in the IRP's portal.
COMPLIANCE_IRP_USERNAME=
COMPLIANCE_IRP_PASSWORD=
# How long to wait for the portal, in milliseconds. Unset uses 15000. A timeout is never
# read as a rejection — the document stays pending, because it may have been registered.
COMPLIANCE_IRP_TIMEOUT_MS=
# Comma-separated user ids that hold the vendor's platform-only capabilities — today that
# is administration of the global marketing blog, whose tables have no org_id. These keys
# are outside every organization's permission catalog, so no org owner, org admin, role
# grant or delegation can reach them. Unset means nobody, which is the correct default.
PLATFORM_ADMIN_USER_IDS=
# REQUIRED (min 32 chars; 64 hex recommended). Encrypts payment-provider secrets and
# employee PII at rest. The app refuses to start without it — absence must never
# silently degrade to plaintext storage.
ENCRYPTION_KEY=
# Optional; falls back to BACKEND_JWT_SECRET.
# AI_CONFIRMATION_SECRET=
# zeptomail | resend
EMAIL_PROVIDER=zeptomail
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# Mail Agent Send Mail API key ("Zoho-enczapikey ..." prefix optional).
ZEPTOMAIL_TOKEN=
RESEND_API_KEY=
# Bounce/complaint webhooks (POST /webhooks/email/:provider). Unset = the endpoint
# rejects every callback, so bounces are never suppressed — set these in any
# environment that actually sends mail.
# Resend signs with Svix: the whsec_ value from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
# ZeptoMail: shared secret sent as x-zeptomail-webhook-secret. Stopgap until the
# provider's documented signature scheme is confirmed against a live account.
ZEPTOMAIL_WEBHOOK_SECRET=
# COMP-002. Signs one-click unsubscribe links (>=32 chars). Deliberately NOT the
# session JWT secret: these tokens travel in plain-text email and live in archives
# forever, so a leak must not be replayable against anything else. Unset disables
# unsubscribe links entirely.
UNSUBSCRIBE_TOKEN_SECRET=
EMAIL_FROM_ADDRESS=noreply@streamlineos.in
EMAIL_FROM_NAME=StreamlineOS
# Under NODE_ENV=test the email provider clients are null, so no suite can send real
# mail. Set to 1 ONLY to deliberately re-arm live sending in a test run. A suite once
# sent 14 real messages because a live token reached it; leave this unset.
# EMAIL_ALLOW_LIVE_SEND=1
# Public site URL for email links when APP_URL is a local/LAN address.
# EMAIL_APP_URL=https://www.streamlineos.in
# This API's own public origin. Needed ONLY for RFC 8058 one-click unsubscribe,
# where the mail client POSTs the List-Unsubscribe URL itself and therefore has
# to reach the API, not the web app. Leave it unset and those headers are simply
# not sent -- an absent opt-out beats one that 404s.
# PUBLIC_API_URL=https://api.streamlineos.in
# Contact-form notification recipient; required in production.
CONTACT_NOTIFICATION_EMAIL=
# Organizer address on ICS interview invites.
NOREPLY_EMAIL=noreply@streamlineos.in
# SMS/WhatsApp channel; unset disables it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMS one-time codes for e-signature. Both are required together — EnvSmsSender
# offers the otp_sms signer authentication method only when both are set, so one
# without the other leaves the method switched off with no error anywhere.
# No provider implementation is bound yet; setting these alone does not send SMS.
SIGN_SMS_PROVIDER_URL=
SIGN_SMS_PROVIDER_TOKEN=
# Pairs with frontend NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=true
# Managed integrations (calendar + mail) — app.composio.dev
# COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR also backs chat huddles: a huddle mints its Google Meet
# link through GOOGLECALENDAR_CREATE_EVENT, so without a connected Google account huddles refuse
# to start.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_AUTH_CONFIG_GOOGLE_CALENDAR=
# Shared secret the calendar provider relay sends as x-calendar-webhook-secret. It is the
# ONLY check on POST /webhooks/calendar/provider, which is public and carries no session.
# >=32 chars. Leave unset to keep the receiver undeployed — it then refuses every delivery
# with 503 rather than accepting an unauthenticated one. Set it only if you receive
# provider callbacks, and set it to something you generated, not a placeholder.
CALENDAR_PROVIDER_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe is the second platform payment provider. Optional: unset leaves
# `StripeService.isConfigured()` false, and provider selection falls back to
# Razorpay. STRIPE_WEBHOOK_SECRET is the `whsec_...` signing secret, not an API key.
# Stripe has no client-side payment signature, so the webhook is the ONLY way a
# Stripe payment activates anything. Point the endpoint at
# POST /webhooks/stripe/<orgId>, subscribed to payment_intent.succeeded,
# payment_intent.payment_failed and charge.refunded.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated recipients for waitlist signup notices. Falls back to the two
# addresses in waitlist.service.ts when unset.
WAITLIST_NOTIFICATION_EMAILS=
# Set true to make an undeclared route fail at boot and at request time, rather
# than only appearing in the boot report. Flip once that report reaches zero.
# REQUIRE_ROUTE_CLASSIFICATION=false
# Embeddings/KB RAG always use OPENAI_API_KEY — keep it set even on openrouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# openai (default) | openrouter
AI_LLM_PROVIDER=
# Model fallback chains, comma-separated, tried in order after the tier's primary model
# when it rate-limits (429), is overloaded (503), or keeps failing transiently. Unset falls
# back to the other tier's configured model, so the chain only holds models you already have.
# Auth and malformed-request failures never retry or fall through — they fail identically.
# AI_FAST_FALLBACK_MODELS=gpt-4o,gpt-3.5-turbo
# AI_STANDARD_FALLBACK_MODELS=gpt-4o-mini
# Retries per model before moving to the next one (default 2, max 5). Backoff is exponential
# with jitter and honours the provider's Retry-After header.
# AI_LLM_MAX_RETRIES=2
# google (default) | openrouter
AI_CHAT_PROVIDER=
R2_REGION=auto
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Public CDN base URL, no trailing slash; read by the BACKEND despite the prefix.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Optional dedicated KB media bucket; falls back to the main bucket.
R2_KB_BUCKET_NAME=
R2_KB_PUBLIC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Milliseconds a Redis command may take before the cache gives up on it. Minimum 100.
# REDIS_COMMAND_TIMEOUT_MS=3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ABLY_API_KEY=
# Optional tuning (defaults shown).
# APP_BRAND_NAME=StreamlineOS
# CHAT_REPLY_REMINDER_MINUTES=15
# NOTIFICATIONS_INPROCESS_WORKER=true
# NOTIFICATIONS_WORKER_INTERVAL_MS=15000
# PAYROLL_INPROCESS_WORKER=true
# HR_EXPORT_WORKER_ENABLED=false
# PAYROLL_EXPORT_WORKER_ENABLED=false
# PAYROLL_JOBS_WORKER_ENABLED=false
# EXPENSE_EXPORT_WORKER_ENABLED=false
# FINANCE_REPORT_EXPORT_WORKER_ENABLED=false
# GDPR_EXPORT_WORKER_ENABLED=false
# KB_CHAT_PURGE_WORKER_ENABLED=false
# content | clamav | virustotal; unset behaves as `content`.
# `content` is always active and runs FIRST: structural inspection of the uploaded bytes
# (EICAR, executable/shebang magic, OOXML and OLE VBA macros, PDF /JavaScript /JS /Launch).
# It carries no malware signatures — set clamav for those, and both layers then apply.
# Every scanner fails closed: a scanner error blocks the upload (503) rather than letting it through.
# NOTE: virustotal is a HASH LOOKUP ONLY and never uploads file bytes, so a file VirusTotal has
# never seen is refused. It is unsuitable for user-generated uploads such as screenshots.
# AV_SCANNER=
# Required when AV_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Required when AV_SCANNER=virustotal
# VIRUSTOTAL_API_KEY=
# STARTER trial length in days; 14 when unset.
# TRIAL_DAYS=14
# Comma-separated user ids permitted to run a data subject erasure or export
# (POST /compliance/subject-requests). Unset authorises NOBODY -- the permission
# key is held by every organisation owner and the operation is cross-tenant.
# COMPLIANCE_SUBJECT_REQUEST_OPERATORS=
# Enables the transactional outbox relay. Set false only during a controlled maintenance window.
# OUTBOX_DISPATCH_ENABLED=true
# In-process outbox drain every 15s under the same lease as POST /cron/outbox-events-worker.
# On unless set to exactly "false"; always off under NODE_ENV=test. Turn off only where an
# external scheduler already POSTs that endpoint — nothing does by default.
# OUTBOX_INPROCESS_WORKER=true
# In-process retention sweeps. On unless set to exactly "false"; always off under NODE_ENV=test.
# Turn off only where something else already drives the sweeps — nothing else does by default,
# and a sweep nobody triggers is indistinguishable from one that works.
# RETENTION_SCHEDULER_ENABLED=true
# Milliseconds between retention passes.
# RETENTION_SCHEDULER_TICK_MS=600000
# Turns an undeclared route (no @Public/@Universal/@RequirePermission) from a
# logged warning into a hard failure, at boot and at request time.
# REQUIRE_ROUTE_CLASSIFICATION=false
# Comma-separated recipients for waitlist signup notifications.
# WAITLIST_NOTIFICATION_EMAILS=
# Sales-channel adapter. "fake" drives the built-in test double and is refused in
# production; "shopify" is the real Shopify Admin API adapter (INV-27) and needs
# the access token below. "none" registers nothing at all, which is what an
# organisation that reconciles its marketplace by hand should have.
# INV_CHANNEL_ADAPTER=none
# HMAC secrets an inbound channel webhook is verified against. Absent means the
# corresponding channel type refuses every delivery — never "skip verification".
# INV_CHANNEL_WEBHOOK_SECRET_SHOPIFY=
# INV_CHANNEL_WEBHOOK_SECRET_WOOCOMMERCE=
# INV_CHANNEL_WEBHOOK_SECRET_DEFAULT=
# INV-27. The Shopify Admin API access token, required by INV_CHANNEL_ADAPTER=shopify
# and refused at boot without it. One token is one store: a multi-tenant deployment
# needs this to arrive from a Composio connected account instead (root CLAUDE.md §5),
# and until it does, one Shopify channel per deployment is the honest limit.
# INV_CHANNEL_SHOPIFY_ACCESS_TOKEN=
# Pinned, never floating — Shopify removes an API version after a year. Unset uses
# the adapter's own pinned default.
# INV_CHANNEL_SHOPIFY_API_VERSION=2024-10
# How long to wait for the store. Unset uses the adapter's 15s default.
# INV_CHANNEL_SHOPIFY_TIMEOUT_MS=
# --- Materials pack (construction and interior materials) ---
# The pack itself is an organisation setting, not an env var: turn it on at
# PATCH /inventory/settings with { "packMaterials": true }, or through Inventory →
# Settings. With it off, the catalogue attributes are stripped from every
# response, refused on every write, and /inventory/projects 404s.
#
# A second dev server on one checkout needs its own build directory, because
# `next dev` locks <distDir>/dev. Set this in the *frontend* environment:
#   NEXT_DIST_DIR=.next-local npx next dev -p 1002
#
# Local development database (never a shared or production one).
#   DATABASE_URL=postgresql://<you>@127.0.0.1:5432/streamline_dev
#   DIRECT_DATABASE_URL=postgresql://<you>@127.0.0.1:5432/streamline_dev
#   APP_DATABASE_URL=postgresql://<app-role>:<password>@127.0.0.1:5432/streamline_dev
# APP_DATABASE_URL must be a NON-owner role: running as the owner has BYPASSRLS
# and hides every tenant-isolation bug. `pnpm db:bootstrap-role` mints one.
#
# Webhook delivery is signed with a per-endpoint secret generated on creation and
# never shown again — there is no env var for it. See docs/inventory-materials-pack.md.

# HMAC key pseudonymising public-roadmap voter IPs; falls back to BACKEND_JWT_SECRET.
# VOTE_IP_SALT=
# Shown to recipients in transactional email; falls back to the from-address.
# BRAND_SUPPORT_EMAIL=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Logo path appended to NEXT_PUBLIC_R2_PUBLIC_URL in email templates.
# EMAIL_LOGO_PATH=



