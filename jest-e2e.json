{
  "moduleFileExtensions": ["js", "json", "ts", "mjs", "cjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j|mj)s$": ["ts-jest", { "tsconfig": { "allowJs": true }, "diagnostics": false }] },
  "transformIgnorePatterns": ["/node_modules/(?!.*(?:@scure|otplib|@otplib|@noble|@composio))"],
  "moduleNameMapper": { "^src/(.*)$": "<rootDir>/src/$1" },
  "setupFiles": ["dotenv/config"]
}
