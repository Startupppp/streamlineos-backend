{
  "name": "streamlineos-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/@nestjs/cli/bin/nest.js build",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json",
    "start": "node --max-old-space-size=8192 ./node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --max-old-space-size=8192 --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --builder swc --watch",
    "start:prod": "node --max-old-space-size=8192 --env-file-if-exists=.env dist/main.js",
    "db:push": "node scripts/guard-db-push.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:bootstrap": "node src/scripts/db-bootstrap.mjs",
    "db:bootstrap-role": "node src/scripts/db-bootstrap-app-role.mjs",
    "db:setup": "node src/scripts/db-setup.mjs",
    "db:verify-rls": "node src/scripts/db-verify-rls.mjs",
    "db:reconcile-journal": "node scripts/migration-journal-reconcile.mjs migrations",
    "db:check-build-reads": "node src/scripts/check-build-read-cost.mjs",
    "db:check-read-budgets": "node src/scripts/run-read-cost-budgets.mjs",
    "db:check-read-budgets:self-test": "node src/scripts/run-read-cost-budgets.mjs --self-test",
    "db:check-read-budgets:verify": "node src/scripts/__tests__/plan-walker.test.mjs",
    "db:check-read-budgets:build": "node src/scripts/run-read-cost-budgets.mjs --ids=scoped-board-page,my-work,ticket-list-project,ticket-org-assigned-to-me",
    "hrms:schema-bundle": "node --env-file-if-exists=.env -r ts-node/register src/scripts/hrms-schema-bundle/hrms-schema-bundle.ts",
    "seed:marketplace-apps": "node --env-file=.env -r ts-node/register src/db/seeds/marketplace-apps.seed.ts",
    "purge:user": "node src/scripts/purge-user.mjs",
    "e2e:smoke": "node src/scripts/e2e-smoke.mjs",
    "alert:dead-outbox": "node --env-file-if-exists=.env src/scripts/alert-dead-outbox.mjs",
    "alert:dead-outbox:self-test": "node src/scripts/alert-dead-outbox.mjs --self-test",
    "alert:dead-delivery": "node --env-file-if-exists=.env src/scripts/alert-dead-delivery.mjs",
    "alert:dead-delivery:self-test": "node src/scripts/alert-dead-delivery.mjs --self-test",
    "alert:sig-failures": "node --env-file-if-exists=.env src/scripts/alert-sig-failures.mjs",
    "alert:sig-failures:self-test": "node src/scripts/alert-sig-failures.mjs --self-test",
    "alert:tenant-ctx-errors": "node src/scripts/alert-tenant-ctx-errors.mjs",
    "alert:tenant-ctx-errors:self-test": "node src/scripts/alert-tenant-ctx-errors.mjs --self-test",
    "alert:p95": "node src/scripts/alert-p95.mjs",
    "alert:p95:self-test": "node src/scripts/alert-p95.mjs --self-test",
    "verify:chat-mentions": "node --env-file=.env src/scripts/verify-chat-mention-delivery.mjs",
    "verify:permissions": "node src/scripts/check-permission-keys.mjs",
    "seed:build-load": "node --env-file=.env src/scripts/seed-build-load.mjs",
    "baseline:build": "node --env-file=.env src/scripts/capture-build-baseline.mjs",
    "backfill:member-roles": "node src/scripts/backfill-member-role-assignments.mjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "setup:r2": "node --env-file=.env -r ts-node/register src/scripts/setup-r2-buckets.ts",
    "backfill:system-roles": "node --env-file=.env -r ts-node/register src/scripts/backfill-system-roles.ts",
    "backfill:crm-metadata": "node --env-file=.env -r ts-node/register src/scripts/backfill-crm-metadata.ts",
    "backfill:person-employment": "node --env-file=.env -r ts-node/register src/scripts/backfill-person-employment.ts",
    "backfill:kb-pages": "node --env-file=.env -r ts-node/register src/scripts/backfill-kb-pages.ts",
    "convert:kb-articles": "node --env-file=.env -r ts-node/register src/scripts/convert-kb-articles.ts",
    "report:kb-article-migration": "node --env-file=.env -r ts-node/register src/scripts/report-kb-article-migration.ts",
    "report:kb-calendar-runtime": "node --env-file=.env -r ts-node/register src/scripts/report-kb-calendar-runtime-evidence.ts",
    "report:outbox-events": "node --env-file=.env -r ts-node/register src/scripts/report-outbox-events.ts",
    "seed:payroll-templates": "node --env-file=.env -r ts-node/register src/scripts/seed-payroll-templates.ts",
    "seed:enterprise": "node --env-file=.env -r ts-node/register src/scripts/seed-enterprise-workspace.ts",
    "seed:demo-coupons": "node --env-file=.env -r ts-node/register src/db/seeds/demo-coupons.seed.ts",
    "seed:ai-credit-packs": "node --env-file=.env -r ts-node/register src/db/seeds/ai-credit-packs.seed.ts",
    "seed:demo": "node --env-file=.env -r ts-node/register src/scripts/seed-demo.ts",
    "seed:permissions": "node --env-file=.env -r ts-node/register src/scripts/seed-permissions.ts",
    "mcp": "node scripts/mcp-server.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./jest-e2e.json",
    "test:e2e:ci": "node --max-old-space-size=6144 ./node_modules/jest/bin/jest.js --config ./jest-e2e.json --runInBand --forceExit",
    "test:e2e:seeded": "node --max-old-space-size=12288 ./node_modules/jest/bin/jest.js --config ./jest-e2e-seeded.json --forceExit --runInBand",
    "test:e2e:support": "node --max-old-space-size=6144 ./node_modules/jest/bin/jest.js --config ./jest-e2e.json --runInBand --testPathPattern=support",
    "db:check-request-txn": "node src/scripts/check-request-transaction-cost.mjs",
    "check:cycles": "npx --yes madge@8 --circular --extensions ts src",
    "check:route-classification": "node src/scripts/route-classification-report.mjs",
    "check:route-classification:self-test": "node src/scripts/route-classification-report.mjs --self-test",
    "check:permission-keys": "node src/scripts/check-permission-keys.mjs",
    "check:permission-keys:self-test": "node src/scripts/check-permission-keys.mjs --self-test",
    "check:navigation-permissions": "node src/scripts/check-navigation-permissions.mjs",
    "check:navigation-permissions:self-test": "node src/scripts/check-navigation-permissions.mjs --self-test",
    "check:tenant-indexes": "node src/scripts/check-tenant-indexes.mjs",
    "check:tenant-indexes:self-test": "node src/scripts/check-tenant-indexes.mjs --self-test",
    "check:scope-application": "node src/scripts/check-scope-application.mjs",
    "check:scope-application:self-test": "node src/scripts/check-scope-application.mjs --self-test",
    "check:record-access": "node src/scripts/check-record-access.mjs",
    "check:record-access:self-test": "node src/scripts/check-record-access.mjs --self-test"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.33",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@composio/core": "^0.14.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.4.4",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@upstash/redis": "^1.37.0",
    "ably": "^2.23.0",
    "ai": "^7.0.51",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "0.32.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.16.0",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "ua-parser-js": "^1.0.40",
    "web-push": "^3.6.7",
    "zeptomail": "^8.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.43",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "knip": "^6.31.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/evals"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "e2e-spec",
      "node_modules",
      "dist"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ],
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          },
          "diagnostics": false,
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:\\.pnpm/)?(?:@scure|otplib|@otplib|@noble|@composio|@openrouter|@ai-sdk|@workflow|@standard-schema|eventsource-parser|ai)[@/+])"
    ],
    "setupFiles": [
      "<rootDir>/src/test/jest-setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "workerIdleMemoryLimit": "1GB",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
